          "name": "List organization time edit logs",
          "request": {
            "name": "List organization time edit logs",
            "description": {
              "content": "Returns a collection of time edit logs (manual time additions/edits/deletions) for the given organization.\n\nResults can be filtered by created[start]/[stop], user_ids[], task_ids[], and project_ids[].\n\nNote: Date range limit is 31 days. Earliest date is 3 years ago.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "organizations",
                ":organization_id",
                "time_edit_logs"
